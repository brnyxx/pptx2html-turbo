# CODEOWNERS — GitHub 레벨 (유지보수 안전장치)
#
# NOTE: Multica agent 기반 L6.4 domain reviewer 라우팅은 `.multica/codeowners.yaml` 에 별도 관리.
#       GitHub Native Review는 여기서, 에이전트 dispatch는 multica daemon이 처리.

# 기본: 저장소 관리자 (사용자 본인)
*                       @brnyxx

# ADR은 항상 본인 검토 필수 (HITL 예외)
/docs/adr/              @brnyxx

# CI/보안 설정 변경은 본인 검토
/.github/               @brnyxx
/.multica/              @brnyxx
/deploy/                @brnyxx
/infra/                 @brnyxx
Dockerfile              @brnyxx
docker-compose*.yml     @brnyxx

# 시크릿·마이그레이션
*secrets*               @brnyxx
*.env*                  @brnyxx
/migrations/            @brnyxx
*.sql                   @brnyxx
