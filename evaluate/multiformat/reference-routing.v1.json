{
  "schema_version": 1,
  "reference_profile": "libreoffice-poppler",
  "canonicalizer_version": "2",
  "canonicalizer_implementation_sha256": "547531d65133765274b06373a432246a6375b2f424e28f4ceb15b30030f4dfd5",
  "runtime": {
    "environment_whitelist": ["HOME", "LANG", "LC_ALL", "TZ"],
    "locale": "en-US",
    "timezone": "UTC",
    "network_isolation": true
  },
  "routes": [
    {
      "format": "doc",
      "normative_input": "source",
      "commands": [
        {
          "tool_role": "libreoffice",
          "arguments": ["--headless", "--nologo", "--nodefault", "--nolockcheck", "--nofirststartwizard", "-env:UserInstallation={profile_uri}", "--convert-to", "pdf", "--outdir", "{output_dir}", "{source}"],
          "timeout_seconds": 120,
          "output_name": "reference.pdf"
        },
        {
          "tool_role": "poppler_metadata",
          "arguments": ["{reference_pdf}"],
          "timeout_seconds": 120,
          "output_name": "pdfinfo.txt"
        },
        {
          "tool_role": "poppler_render",
          "arguments": ["-png", "-r", "144", "{reference_pdf}", "{render_prefix}"],
          "timeout_seconds": 120,
          "output_name": "page"
        },
        {
          "tool_role": "poppler_text",
          "arguments": ["-bbox-layout", "-enc", "UTF-8", "{reference_pdf}", "{text_output}"],
          "timeout_seconds": 120,
          "output_name": "text-layout.html"
        }
      ]
    },
    {
